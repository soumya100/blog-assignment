# =============================================
# CLIENT (Vercel) Environment Variables
# =============================================
# Set these in Vercel Dashboard -> Project -> Settings -> Environment Variables

# Backend API URL (your Render service URL)
# Example: https://devlog-api.onrender.com/api/v1
VITE_API_URL=https://your-render-service.onrender.com/api/v1

# Socket.io server URL (same Render service, without /api/v1)
# Example: https://devlog-api.onrender.com
VITE_SOCKET_URL=https://your-render-service.onrender.com
