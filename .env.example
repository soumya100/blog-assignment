# ==========================================
# SECURE MERN BLOG PLATFORM - ENV CONFIGURATION
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration
# Provide your MongoDB Atlas or local MongoDB connection URI:
# e.g., mongodb://localhost:27017/blog_platform
# If empty or not reachable in development, server automatically launches embedded in-memory MongoDB
MONGODB_URI=

# Security & JWT Credentials (Must use strong, random secrets in production)
JWT_ACCESS_SECRET=super_secure_access_secret_change_in_production_key_123456789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secure_refresh_secret_change_in_production_key_987654321
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security
COOKIE_SECRET=super_cookie_secret_change_me_in_production_34982347
COOKIE_DOMAIN=localhost

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# OAuth 2.0 Credentials (Optional: if empty, mock dev sandbox mode is active)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

FACEBOOK_CLIENT_ID=your_facebook_app_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret_here
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@blogplatform.dev
ADMIN_PASSWORD=AdminSecurePass123!
ADMIN_USERNAME=systemadmin

# ==========================================
# Email & SMTP Delivery Configuration (Gmail / Custom SMTP)
# ==========================================
# For real Gmail delivery, generate a 16-character Google App Password:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords (select app: 'Mail')
# 3. Paste the 16-character code below into SMTP_PASSWORD (spaces are automatically stripped)
#
# If left empty in development/test, server falls back to Ethereal sandbox (preview link in logs).
# In production (NODE_ENV=production), valid SMTP credentials are strictly required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM="DevLog Security" <your-email@gmail.com>

